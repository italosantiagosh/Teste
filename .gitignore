.env
__pycache__/
*.pyc

# Dados reais (planilhas baixadas, saidas geradas e logs) nunca devem ser
# versionados - apenas a estrutura de pastas (.gitkeep) fica no repositorio.
entrada/*
!entrada/.gitkeep
saida/*
!saida/.gitkeep
logs/*
!logs/.gitkeep

# Artefatos gerados pelo PyInstaller ao criar o executavel - nao versionar
# (o .exe final e binario, grande, e depende da maquina onde foi gerado).
build/
dist/
*.spec
AutomacaoTransportadora.exe

# gerador_medalhas: imagens dos santos (arte do usuario, nao vai pro repo)
# e folhas geradas (saida) nunca devem ser versionadas.
gerador_medalhas/imagens/*
!gerador_medalhas/imagens/.gitkeep
gerador_medalhas/saida/*
!gerador_medalhas/saida/.gitkeep
