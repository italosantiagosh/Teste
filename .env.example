# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA versione o arquivo ".env" (adicione-o ao .gitignore).

URL_SISTEMA=https://sistema.ssw.inf.br/bin/ssw0422
NAVEGADOR=chrome
# Deixe em branco (ou apague a linha) para baixar direto na pasta
# 'entrada/' do projeto, que já é o padrão. Só preencha se quiser usar
# outra pasta de fato existente no seu computador.
PASTA_DOWNLOADS=
TIMEOUT_PADRAO_SEGUNDOS=20

# Domínio geralmente já vem preenchido pelo sistema (ex.: CDI). Só defina
# se precisar sobrescrever.
SISTEMA_DOMINIO=

# CPF é obrigatório em uma sessão nova do navegador (sem o cookie de
# "Lembrar CPF"). É um dado sensível — mantenha este arquivo fora de
# qualquer repositório compartilhado.
SISTEMA_CPF=

SISTEMA_USUARIO=
# Se deixar SISTEMA_SENHA em branco, o programa pergunta a senha na hora
# de rodar (sem mostrar na tela), em vez de guardá-la em arquivo.
SISTEMA_SENHA=

# Código da unidade usado para navegar pelo menu (ex.: GRU)
UNIDADE_PADRAO=GRU
